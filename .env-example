# --- credentials and endpoints (used by the frontend and by every bot) ---
OPENAI_API_KEY=chatbots2425
MODEL_NAME=Qwen/Qwen2.5-Coder-14B-Instruct
OPENAI_API_BASE=http://gpu01.imn.htwk-leipzig.de:8081/v1
PIZZA_API_BASE=https://wse-research.org/pizza-api
QANARY_API_BASE=http://demos.swe.htwk-leipzig.de:40111
LANGCHAIN_API_KEY=...

# Set to 1 to run without any LLM endpoint: the AI-backed steps then use the
# rule implementations (run_local.sh sets this automatically when the endpoint
# above cannot be reached).
PIZZABOT_OFFLINE=0

# --- which LangGraph implementation the frontend talks to ----------------
# The keys come from apps.json; the picker in the header can switch live.
PIZZABOT_APP=demo
# Where the course exercises are checked out (used by apps.json).
L3_PATH=../saint-etienne-exercise-03/student
