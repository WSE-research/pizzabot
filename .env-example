# Copy this file to `.env` and fill in what you have. `run_local.sh` does the
# copy for you when `.env` is missing. Nothing here is secret until you put a
# key in it -- and `.env` is gitignored, so your key never leaves your machine.
#
# `settings.py` is the only module that reads this file. The frontend, the
# console bot and every implementation the frontend loads read it through
# there, so they cannot disagree about what they are talking to.

# --- the LLM, for the AI-backed steps -------------------------------------
# Any OpenAI-compatible endpoint: a hosted service, your institution's server,
# or one running on your own machine. Ask its /models for the name to put in
# MODEL_NAME. Leave all three empty and the bot still runs -- see
# PIZZABOT_OFFLINE below, which is why this example ships with it turned on.
OPENAI_API_BASE=
OPENAI_API_KEY=
MODEL_NAME=

# Run without any LLM endpoint: the three AI-backed steps (intent check,
# address extraction, pizza description) are then answered by deterministic
# rules of the same signature. `run_local.sh` probes the endpoint above and
# sets this by itself -- 1 when it does not answer, 0 when it does -- so you
# only set it here to force the rules while an endpoint is available.
PIZZABOT_OFFLINE=1

# --- the services ---------------------------------------------------------
# The pizza menu, the delivery area, address validation and orders. This is a
# public instance and it is also the built-in default, so a fresh checkout
# answers "what pizzas do you have?" before you have written anything here.
PIZZA_API_BASE=https://wse-research.org/pizza-api

# Qanary pipeline, used to describe a pizza from Wikidata. Without it the
# description step falls back to what it can say on its own.
QANARY_API_BASE=http://demos.swe.htwk-leipzig.de:40111

# Optional: LangSmith tracing, and the evaluation in test_pizzabot.py.
LANGCHAIN_API_KEY=

# --- which LangGraph implementation the frontend talks to -----------------
# A key from apps.json. `./run_local.sh --app KEY` wins over this, and the
# picker in the header switches between them while the app runs;
# `./run_local.sh --apps` lists the keys without starting anything.
PIZZABOT_APP=demo

# Paths that apps.json refers to as ${...}. An entry whose path is not set is
# listed in the UI as unavailable, with the reason -- it does not break
# anything. Add one variable per implementation you register.
L3_PATH=../saint-etienne-exercise-03/student
